{
  "name": "nativele-testing-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "ts-dom check src/nv && vite build",
    "test": "vitest run --project unit --project jsdom",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "verify": "npm test && ts-dom check src/nv && ts-dom doctor src/nv && npm run test:browser && npm run test:e2e"
  },
  "dependencies": {
    "@nativele/ts-dom": "file:../../.."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/browser-playwright": "5.1.0",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
