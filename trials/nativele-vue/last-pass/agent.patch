@@ -0,0 +1,23 @@
+import { Component, define, event } from "@nativele/ts-dom";
+import tpl from "./inventory-item.html.js";
+
+export interface Item {
+  id: number;
+  name: string;
+  qty: number;
+}
+
+export class InventoryItem extends Component(tpl, {
+  shadow: true,
+  props: { item: { id: 0, name: "", qty: 0 } as Item, lowThreshold: 0 },
+  derive: {
+    name: (v) => v.item.name,
+    low: (v) => v.item.qty < v.lowThreshold,
+  },
+  emits: { "item-select": event<{ id: number }>() },
+}) {
+  pick(): void {
+    this.emit("item-select", { id: this.props.item.id });
+  }
+}
+define("nv-inventory-item", InventoryItem);
