@@ -1,7 +1,56 @@
 <script setup lang="ts">
-import HelloWorld from './components/HelloWorld.vue'
+import { computed, ref, watch } from "vue";
+import type { Item } from "./nv/inventory-item.js";
+import { total } from "./nv/inventory-store.js";
+import SummaryPanel from "./SummaryPanel.vue";
+import InventoryFooter from "./InventoryFooter.vue";
+
+const items = ref<Item[]>([
+  { id: 1, name: "apple", qty: 3 },
+  { id: 2, name: "pear", qty: 0 },
+  { id: 3, name: "plum", qty: 7 },
+]);
+const selectedId = ref<number | null>(null);
+const selections = ref(0);
+const showSummary = ref(true);
+
+const selected = computed(() => items.value.find((i) => i.id === selectedId.value) ?? null);
+
+watch(items, (list) => total.set(list.reduce((sum, i) => sum + i.qty, 0)), { deep: true, immediate: true });
+
+function select(id: number): void {
+  selectedId.value = id;
+  selections.value++;
+}
+
+function setQty(value: number): void {
+  const index = items.value.findIndex((i) => i.id === selectedId.value);
+  if (index >= 0) items.value[index] = { ...items.value[index]!, qty: value };
+}
+
+function reverse(): void {
+  items.value = [...items.value].reverse();
+}
 </script>
 
 <template>
-  <HelloWorld />
+  <h1>Inventory</h1>
+  <button type="button" @click="reverse">Reverse order</button>
+  <nv-inventory-item
+    v-for="item in items"
+    :key="item.id"
+    :item="item"
+    :lowThreshold="2"
+    @item-select="(e) => select(e.detail.id)"
+  >
+    <span v-if="item.qty === 0" slot="badge">out of stock</span>
+  </nv-inventory-item>
+  <p>Selected: {{ selected ? selected.name : "none" }}</p>
+  <p>Selections: {{ selections }}</p>
+  <nv-qty-input v-if="selected" :value="selected.qty" @value-change="(e) => setQty(e.detail.value)" />
+  <button type="button" @click="showSummary = !showSummary">Toggle summary</button>
+  <KeepAlive>
+    <summary-panel v-if="showSummary" />
+  </KeepAlive>
+  <inventory-footer />
 </template>
